rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /reviews/{reviewId}.webm {
      allow read: if true;
      allow write: if request.resource != null
        && request.resource.contentType.matches('audio/.*')
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}